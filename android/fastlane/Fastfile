  desc "Download metadata from Play Store"
  lane :download_metadata do
    supply(
      track: 'beta', # or 'beta', 'alpha', 'internal'
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      download_metadata: true
    )
  end

  desc "Upload metadata (store listing, graphics, screenshots) to Play Console"
  lane :upload_metadata do
    supply(
      # If you have android/fastlane/Appfile configured, you can omit json_key/package_name
