{
  "name": "tbd-edu",
  "version": "1.0.0",
  "scripts": {
    "prepare": "husky install",
    "dev": "expo start --dev-client",
    "web": "expo start --web --dev-client",
    "android": "expo run:android --variant 'devDebug' --device",
    "android:release": "expo run:android --variant 'devRelease' --device",
    "ios": "expo run:ios",
    "eject": "expo eject",
    "lint": "eslint ./src --ext .ts,.tsx --max-warnings 0",
    "start": "expo start --dev-client",
    "reactNativeStart": "react-native start",
    "reactNativeIos": "react-native run-ios",
    "postinstall": "patch-package",
    "create:native-module": "npx create-react-native-library@latest",
    "icon": "rn-toolbox icons ./assets/images/icon.png",
    "splash": "rn-toolbox splash .assets/images/splash.png",
    "link:node": "echo export NODE_BINARY=$(command -v node) > .xcode.env.local",
    "link:assets": "npx react-native-asset",
    "gen:i18n": "cd src/core/presentation/i18n/locales && ./locale.sh",
    "bundle:analyze": "cd script && ./bundle-analyzer.sh",
    "bundle:check": "cd script && ./asset-monitor.sh",
    "codepush:safe": "cd script && ./codepush-with-analysis.sh"
  },
